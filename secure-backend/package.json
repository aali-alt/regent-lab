{
  "name": "regent-lab-secure-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node server.mjs",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-regent-lab \"node --test test/emulator.mjs\"",
    "test:ui": "firebase emulators:exec --only firestore,auth --project demo-regent-lab \"node test/ui-roundtrip.mjs\""
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "firebase-admin": "^14.5.1"
  },
  "devDependencies": {
    "@babel/parser": "8.1.3",
    "@babel/traverse": "8.1.3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-emoji": "^5.3.2",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.37.0",
    "playwright-core": "^1.65.1",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
